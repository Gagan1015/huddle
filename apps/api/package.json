    "@huddle/shared": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5",
    "cors": "2.8.6",
    "dotenv": "18.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mariadb": "3.5.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
