# API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# XAMPP MariaDB through Prisma's mysql connector
# Create a dedicated local huddle_user rather than using the XAMPP root account.
DATABASE_URL=mysql://huddle_user:replace_me@127.0.0.1:3306/huddle

# Better Auth
# Generate with: openssl rand -base64 48   (values starting with "replace_" are rejected)
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:4000
# Optional. Google sign-in is only offered when both values are set.
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Anthropic (meeting-notes import, Phase 4)
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=replace_with_supported_model

# Seed (optional overrides for `pnpm --filter @huddle/api db:seed`)
# SEED_DEMO_PASSWORD=huddle-demo-2026
# SEED_RESET=1

# Web (only VITE_ variables are exposed to the browser)
# Leave empty in development: Vite proxies /api and /socket.io to the API so
# auth cookies stay same-origin. Set an absolute origin only for split deployments.
VITE_API_URL=
