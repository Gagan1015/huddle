{
  "name": "huddle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "24.21.x",
    "pnpm": "10.30.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @huddle/api db:generate",
    "db:validate": "pnpm --filter @huddle/api db:validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "turbo": "2.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
